# Copy to .env and edit. Real environment variables always override this file.
PORT=3000
NODE_ENV=production

# Where the SQLite database and uploaded dish photos live. MOUNT A PERSISTENT VOLUME HERE.
DATA_DIR=./data

# First-run owner account (only used when the database is empty).
# If ADMIN_PASSWORD is empty in production, a random one is generated and printed ONCE in the server log.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=

# Never enable demo data in production.
SEED_DEMO=false

# Behind a reverse proxy / HTTPS (Nginx, Caddy, Cloud Run, Render, Railway...): keep both true.
# Serving plain http on a LAN or http://IP:port: set SECURE_COOKIES=false or staff sign-in will not stick.
TRUST_PROXY=true
SECURE_COOKIES=true

SESSION_DAYS=14
RESTAURANT_TZ=Asia/Karachi
